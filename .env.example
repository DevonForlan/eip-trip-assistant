# Copy this file to .env and fill in your own values. Never commit .env.
#
# Everything in the repository uses RFC 2606 placeholder hostnames
# (example.com), so nothing reaches a real system until these point at
# yours.

# Entry URL of your EIP instance. Every other host/fragment in the code is
# derived from this, so it is the only place the hostname needs to appear.
EIP_URL=http://eip.example.com/EFNET/

# Domains Chromium may silently send Windows credentials to. Without this
# the dedicated debug profile shows a native credential dialog instead of
# completing SSO - usually your corporate domain with a wildcard.
EIP_AUTH_ALLOWLIST=*.example.com

# Optional overrides - the defaults are fine on a normal Windows install.
# EIP_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# EIP_EDGE_PROFILE_DIR=
# EIP_CDP_URL=http://127.0.0.1:9222
# FORTICLIENT_PATH=C:\Program Files\Fortinet\FortiClient\FortiClient.exe

# Not used by the current flow. Login is always Windows Integrated
# Authentication performed by the browser; this tool never reads, stores or
# transmits a password. Kept here only so nobody reintroduces them casually.
EIP_USERNAME=
EIP_PASSWORD=
